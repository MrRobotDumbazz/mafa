{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/ml_events.schema.json",
  "title": "ML pipeline events",
  "description": "Контракт зоны ml (владелец P2/W3). Версия 1 (2026-10-17, W3): добавлено необязательное поле summary (расшифровка вердикта и label'ов); events[] — без изменений, обратно совместимо с v0-скелетом Genesis.",
  "type": "object",
  "required": ["video_id", "events"],
  "properties": {
    "video_id": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "events": {
      "type": "array",      "items": {
        "type": "object",
        "required": ["type", "timecode_sec", "description", "evidence"],
        "properties": {
          "type": {
            "type": "string",
            "description": "id типа из contracts/violation_catalog.yaml"
          },
          "timecode_sec": {
            "type": "number",
            "minimum": 0
          },
          "timecode_end_sec": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string",
            "description": "Что видно и почему это может указывать на нарушение"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["timestamp_sec"],
              "properties": {
                "timestamp_sec": {
                  "type": "number"
                },
                "frame": {
                  "type": "string",
                  "description": "JPEG: путь к файлу или base64 — формат фиксирует зона ml"
                }
              }
            }
          },
          "normative": {
            "type": "object",
            "description": "Заполняется из violation_catalog.yaml по id типа",
            "properties": {
              "document": { "type": "string" },
              "clause": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Необязательное человекочитаемое резюме (v1): вердикт, бэкенд, клипы и расшифровка label'ов",
      "properties": {
        "verdict": { "type": "string", "enum": ["violation", "no_violation"] },
        "backend": { "type": "string" },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "t0": { "type": "number" },
              "t1": { "type": "number" }
            }
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "title_ru": { "type": "string" },
              "timecode_sec": { "type": "number" },
              "normative": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
